{
  "name": "@leostacowski/pkgs",
  "version": "0.0.2",
  "description": "Centralized package of reusable JavaScript tools.",
  "homepage": "https://www.npmjs.com/package/@leostacowski/pkgs",
  "keywords": [
    "nodejs",
    "javascript",
    "npm"
  ],
  "engines": {
    "node": ">=22.12.0"
  },
  "bugs": {
    "url": "https://github.com/leostacowski/pkgs/issues"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/leostacowski/pkgs.git"
  },
  "license": "Unlicense",
  "author": {
    "name": "leostacowski",
    "email": "leonardo.stacowski@hotmail.com",
    "url": "git+https://github.com/leostacowski/"
  },
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "files": [
    "modules"
  ],
  "exports": {
    ".": "./modules/index.js",
    "./logger": "./modules/logger/index.js",
    "./fs": "./modules/fs/index.js"
  },
  "imports": {
    "#logger/*": "./modules/logger/*",
    "#fs/*": "./modules/fs/*"
  },
  "scripts": {
    "dev": "node --watch ./modules/index.js",
    "deploy": "npm login && npm publish"
  }
}
